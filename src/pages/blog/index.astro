---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog"))
  .filter((e) => !e.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const formatDate = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
---

<BaseLayout
  title="Blog — antora-supplemental"
  description="Longer arguments from antora-supplemental: product policy, upstream gaps, and why we ship what we ship."
  currentPath="/blog/"
>
  <header class="page-intro">
    <p class="hero-kicker page-intro-kicker">Arguments</p>
    <h1 class="page-title">Blog</h1>
    <p class="page-lede">
      Situation, trade-offs, and the case for a change. News carries the dispatch; this channel carries the reasoning.
    </p>
  </header>

  <section class="section news-feed" aria-labelledby="blog-feed-title">
    <h2 id="blog-feed-title" class="visually-hidden">All posts</h2>
    <ol class="news-list">
      {
        posts.map((entry) => (
          <li>
            <time datetime={entry.data.date.toISOString().slice(0, 10)}>{formatDate(entry.data.date)}</time>
            <div>
              <a href={`/blog/${entry.id}/`}>{entry.data.title}</a>
              <p>{entry.data.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
